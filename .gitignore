# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

.godot/

# Windows lock/backup copies of loaded binaries
~*.dll
*.dll~*
*.TMP

# Exported builds and native build products (the extension's sources and built libraries stay)
builds/
gdextension/.vs/
gdextension/.sconsign.dblite
gdextension/src/*.obj
gdextension/demo/bin/*.exp
gdextension/demo/bin/*.lib

# Editor backups
*.png~
