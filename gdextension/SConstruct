#!/usr/bin/env python
import os
import sys
import fnmatch

env = SConscript("godot-cpp/SConstruct")

# For reference:
# - CCFLAGS are compilation flags shared between C and C++
# - CFLAGS are for C-specific compilation flags
# - CXXFLAGS are for C++-specific compilation flags
# - CPPFLAGS are for pre-processor flags
# - CPPDEFINES are for pre-processor defines
# - LINKFLAGS are for linking flags

# tweak this if you want to use different folders, or more folders, to store your source code in.
env.Append(CPPPATH=["src/"])
# The collapse must lay out the same level on every compiler (src/portable.hpp): no fused
# multiply-add, which rounds a * b + c once where the plain operations round twice. MSVC does not
# contract under its default /fp:precise.
if not env.get("is_msvc", False):
    env.Append(CCFLAGS=["-ffp-contract=off"])
sources = Glob("src/*.cpp")

# matches = []
# for root, dirnames, filenames in os.walk('src'):
#   for filename in fnmatch.filter(filenames, '*.c'):
#     sources.append(Glob(os.path.join(root, filename)[len(root)+1:]))


if env["platform"] == "macos":
    library = env.SharedLibrary(
        "demo/bin/libgdexample.{}.{}.framework/libgdexample.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "demo/bin/libgdexample{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)
